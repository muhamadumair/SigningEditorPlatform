  "scripts": {
    "clean:all": "npm run clean:dist && npm run clean:build && npm run clean:node_modules",
    "start": "npm run clear:cache && react-scripts start",
    "start:debug": "npm run clear:cache && set REACT_APP_DEBUG_MODE=true && react-scripts start",
    "build": "npm run clear:cache && npm run clean:build && copy env\\.envCommon .env && craco build",
    "build:debug": "npm run clear:cache && npm run clean:build && copy env\\.envCommon .env && set REACT_APP_DEBUG_MODE=true && craco build",
    "build:library": "npm run clear:cache && npm run clean:build && copy env\\.envLibrary .env && craco build",
    "build:library:debug": "npm run clear:cache && npm run clean:build && copy env\\.envLibrary .env && set REACT_APP_DEBUG_MODE=true && craco build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "compile": "npm i --force && npm run clear:cache && npm run clean:dist && npm run build:esm && npm run build:cjs",
    "clear:cache": "npm cache clean --force",
    "clean:dist": "rimraf dist",
    "clean:build": "rimraf build",
    "clean:node_modules": "rimraf node_modules",
    "build:esm": "tsc",
    "build:cjs": "tsc --module commonjs --outDir dist/cjs",
    "build:rollup": "rimraf dist && rollup -c",
    "minify": "terser --config terser.config.js --output dist/app.min.js src/index.tsx"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
